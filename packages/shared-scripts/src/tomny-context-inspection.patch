+    pub fn refresh_catalog(&mut self, tool_defs: Vec<ToolDef>) {
+        self.tool_defs = tool_defs;
+        let available = self
+            .tool_defs
+            .iter()
+            .map(|tool| tool.name.as_str())
+            .collect::<BTreeSet<_>>();
+        self.loaded.retain(|name| available.contains(name.as_str()));
+    }
+
+    pub fn capability_summary(&self) -> String {
+        if !self.map_initialized {
+            return String::new();
+        }
+        let mut groups = BTreeSet::new();
+        for tool in &self.tool_defs {
+            let text = format!("{} {}", tool.name, tool.description).to_lowercase();
+            let group = if text.contains("secret") || text.contains("credential") {
+                "secret aliases"
+            } else if text.contains("browser") || text.contains("web") {
+                "browser and web"
+            } else if text.contains("memory") || text.contains("context") || text.contains("history") {
+                "memory and context"
+            } else if text.contains("git") || text.contains("diff") || text.contains("commit") {
+                "version control"
+            } else if text.contains("test")
+                || text.contains("terminal")
+                || text.contains("command")
+                || text.contains("exec")
+            {
+                "commands and tests"
+            } else if text.contains("write")
+                || text.contains("edit")
+                || text.contains("patch")
+                || text.contains("create")
+            {
+                "project editing"
+            } else if text.contains("read") || text.contains("search") || text.contains("grep") || text.contains("map")
+            {
+                "project reading and search"
+            } else if text.contains("team") || text.contains("agent") || text.contains("spawn") {
+                "agent collaboration"
+            } else if text.contains("database") || text.contains("table") || text.contains("query") {
+                "data access"
+            } else {
+                "other surface actions"
+            };
+            groups.insert(group);
+        }
+        if groups.is_empty() {
+            "No surface tools are currently available.".to_string()
+        } else {
+            format!(
+                "Available surface capabilities: {}.",
+                groups.into_iter().collect::<Vec<_>>().join("; ")
+            )
+        }
+    }
+
